    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Shared\Shared.Code\Shared.Code.csproj" />
      <ProjectReference Include="..\Orders.Infrastructure\Orders.Infrastructure.csproj" />
    </ItemGroup>

