<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>$(TargetFramework)</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>12</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="$(AspNetCoreOpenApi)"/>
        <PackageReference Include="Swashbuckle.AspNetCore" Version="$(Swashbuckle)"/>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(HealthChecksEntityFrameworkCore)" />
        <!-- Subgraph GraphQL do gateway federado (Fusion); o CommandLine exporta o schema (schema export). -->
        <PackageReference Include="HotChocolate.AspNetCore" Version="$(HotChocolate)" />
        <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="$(HotChocolate)" />
        <PackageReference Include="HotChocolate.Types.Analyzers" Version="$(HotChocolate)" />
        <!-- Spans do GraphQL (add-service-telemetry). -->
        <PackageReference Include="HotChocolate.Diagnostics" Version="$(HotChocolate)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
      <ProjectReference Include="..\..\Frameworker\Frameworker.Observability\Frameworker.Observability.csproj" />
    </ItemGroup>

</Project>
