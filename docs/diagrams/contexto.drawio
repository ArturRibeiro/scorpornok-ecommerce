<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="contexto" name="Contexto">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1290" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="Loja Scorponok: diagrama de contexto&lt;br&gt;&lt;font style=&quot;font-size:12px;font-weight:normal&quot; color=&quot;#666666&quot;&gt;Quem usa o sistema, os contextos que o compõem e os sistemas externos com que ele conversa.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="60" as="geometry" />
        </mxCell>
        <mxCell id="loja" value="&lt;b&gt;Loja Scorponok&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;html=1;whiteSpace=wrap;fontColor=#333333;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="860" height="780.0" as="geometry" />
        </mxCell>
        <mxCell id="cliente" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Navega no catálogo, compra tênis e acompanha o pagamento.&lt;/font&gt;" style="shape=mxgraph.c4.person2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#083F75;strokeColor=#06315C;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="frontend" value="&lt;b&gt;Front-end da loja&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: React + Vite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Catálogo, carrinho, checkout, cadastro do cliente e acompanhamento do pagamento no navegador.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="loja">
          <mxGeometry x="290" y="60" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;Catalog&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: .NET + PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Consulta de produtos e preços (lado de leitura).&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="loja">
          <mxGeometry x="30" y="420.0" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="orders" value="&lt;b&gt;Orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: .NET + PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Registra o pedido, acompanha o pagamento e avisa o cliente.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="loja">
          <mxGeometry x="290" y="420.0" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="payments" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: .NET + PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Tokeniza o cartão, cobra (gateway simulado) e devolve o resultado.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="loja">
          <mxGeometry x="620" y="420.0" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="customers" value="&lt;b&gt;Customers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: .NET + PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cadastro do cliente e histórico dos endereços de entrega.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" vertex="1" parent="loja">
          <mxGeometry x="620" y="620.0" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gateway" parent="loja" vertex="1" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#23A2D9;strokeColor=#0E7DAD;" value="&lt;b&gt;Gateway GraphQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contexto: .NET + Hot Chocolate Fusion]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Ponto de entrada único da loja: valida o token e encaminha a cada contexto.">
          <mxGeometry x="290" y="250" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="keycloak" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Provedor de identidade: cadastro, confirmação de e-mail, login, recuperação de senha e emissão dos tokens.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontSize=12;fontColor=#ffffff;align=center;fillColor=#8C8496;strokeColor=#736782;" vertex="1" parent="1">
          <mxGeometry x="990" y="375" width="260" height="130" as="geometry" />
        </mxCell>
