      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Fluxo de compra&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#666666&quot;&gt;Do catálogo ao resultado do pagamento, com o login quando o cliente ainda não tem sessão.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="inicio" value="Início" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="80" height="40" as="geometry"/></mxCell>
        <mxCell id="catalogo" value="1. Consultar catálogo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;UC01&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="130" y="80" width="140" height="60" as="geometry"/></mxCell>
        <mxCell id="carrinho" value="2. Gerenciar carrinho&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;UC02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="140" height="60" as="geometry"/></mxCell>
