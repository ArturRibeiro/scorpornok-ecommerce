                <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" value="Fluxo de pagamento: contexto Payments&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#666666&quot;&gt;Como funciona hoje: da solicitação recebida do Orders ao resultado publicado.&lt;/font&gt;" vertex="1">
