                <mxCell id="receber" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="1. Receber a solicitação&lt;br&gt;&lt;i&gt;(fila payment-requested)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PaymentRequestedConsumer&lt;/font&gt;" vertex="1">
