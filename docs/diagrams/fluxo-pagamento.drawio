    <diagram id="fluxo-pagamento" name="Fluxo de pagamento (Payments)">
        <mxGraphModel dx="1910" dy="806" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="titulo" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" value="Fluxo de pagamento: contexto Payments&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot; color=&quot;#666666&quot;&gt;Como funciona hoje: da solicitação recebida do Orders ao resultado publicado. Cada tentativa de pagamento do pedido tem a sua chave (pedido-tentativa) e é cobrada no máximo uma vez.&lt;/font&gt;" vertex="1">
                    <mxGeometry x="20" y="0" width="1200" height="45" as="geometry" />
                </mxCell>
                <mxCell id="secao-fluxo" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#333333;" value="Processamento de uma solicitação" vertex="1">
                    <mxGeometry x="20" y="55" width="290" height="20" as="geometry" />
                </mxCell>
                <mxCell id="inicio" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Início" vertex="1">
                    <mxGeometry x="20" y="130" width="90" height="40" as="geometry" />
                </mxCell>
                <mxCell id="receber" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="1. Receber a solicitação&lt;br&gt;&lt;i&gt;(fila payment-requested: pedido, tentativa, total e token do cartão)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PaymentRequestedConsumer&lt;/font&gt;" vertex="1">
                    <mxGeometry x="140" y="100" width="170" height="100" as="geometry" />
                </mxCell>
                <mxCell id="existe" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Já existe pagamento desta tentativa?&lt;br&gt;&lt;i&gt;(chave pedido-tentativa)&lt;/i&gt;" vertex="1">
                    <mxGeometry x="340" y="90" width="200" height="120" as="geometry" />
                </mxCell>
                <mxCell id="emproc" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Ainda em&lt;br&gt;processamento?" vertex="1">
                    <mxGeometry x="590" y="95" width="180" height="110" as="geometry" />
                </mxCell>
                <mxCell id="cobrar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="3. Cobrar no gateway com a chave&lt;br&gt;&lt;i&gt;(simulado: recusa cartão final 0000; com a mesma chave, devolve a resposta original)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PaymentGateway&lt;/font&gt;" vertex="1">
                    <mxGeometry x="830" y="95" width="210" height="110" as="geometry" />
                </mxCell>
                <mxCell id="gravar" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="4. Gravar o resultado&lt;br&gt;&lt;i&gt;(aprovado, ou recusado com o motivo)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PaymentRepository&lt;/font&gt;" vertex="1">
                    <mxGeometry x="1080" y="110" width="170" height="80" as="geometry" />
                </mxCell>
                <mxCell id="aprovado" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Aprovado?" vertex="1">
                    <mxGeometry x="1290" y="100" width="140" height="100" as="geometry" />
                </mxCell>
                <mxCell id="token" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Token do cartão válido?&lt;br&gt;&lt;i&gt;(existe, no prazo e ainda não usado)&lt;/i&gt;" vertex="1">
                    <mxGeometry x="340" y="270" width="200" height="120" as="geometry" />
                </mxCell>
                <mxCell id="processando" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="2. Gravar &quot;em processamento&quot; e marcar o token como usado&lt;br&gt;&lt;i&gt;(antes de cobrar; últimos 4 dígitos, sem CVV)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;PaymentRepository&lt;/font&gt;" vertex="1">
                    <mxGeometry x="600" y="280" width="200" height="100" as="geometry" />
                </mxCell>
                <mxCell id="recusa-token" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Gravar o pagamento recusado, sem cobrar&lt;br&gt;&lt;i&gt;(Token do cartão inválido ou vencido.)&lt;/i&gt;" vertex="1">
                    <mxGeometry x="340" y="440" width="200" height="70" as="geometry" />
                </mxCell>
                <mxCell id="pub-aprovado" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="5. Publicar PaymentApproved&lt;br&gt;&lt;i&gt;(com o id do pagamento e a tentativa)&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#555555&quot;&gt;→ RabbitMQ&lt;/font&gt;" vertex="1">
                    <mxGeometry x="1270" y="290" width="190" height="75" as="geometry" />
                </mxCell>
                <mxCell id="fim" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Fim" vertex="1">
